    /**
     * Admin Store method
     *
     * @return \Cake\Http\Response|void
     */
    public function admin($id = null, $status = 0) {
        $this->loadModel('Carts');
        $cart = $this->Carts->getCount();

        
        if ($this->request->is('post')) {
            $articlesTable = TableRegistry::get('Stores');
            $article = $articlesTable->get($id);  
            $article->trending = $status;
            $articlesTable->save($article);
            return $this->redirect(['action' => 'admin']);
            
        }
        
        
        $trendingModel = $this->Stores->find()->contain( ['Genres', 'Users'])->where(['trending' => 1])->all();
            
        
        
        $g = $this->Stores->find('all')->select(['Users.email', 'Users.aka', 'Stores.id',"Stores.play_count" ,'Stores.name', 'Stores.length', 'Stores.bpm', 'Stores.lease_price', 'Stores.premium_price', 'Stores.exclusive_price', 'Stores.cover', 'Stores.created', 'Stores.lease_path', 'Stores.premium_path', 'Stores.exclusive_path', 'Stores.lease_name', 'Stores.premium_name', 'Stores.exclusive_name', 'Genres.genre'])->contain(['Genres', 'Users']);
        $stores = $this->paginate($g);
        $role = $this->Auth->user('role');
        $this->set(compact('stores', 'role', 'cart','trendingModel'));
        $this->set('_serialize', ['stores']);
    }


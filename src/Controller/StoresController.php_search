        $query = $this->Stores->find('all');
        $query->contain(['Genres', 'Users']);
        $query->select(['Users.id', 'Users.email', 'Users.fullname', 'Users.aka', 'Stores.id', 'Stores.name', 'Stores.length', 'Stores.bpm', 'Stores.lease_price', 'Stores.premium_price', 'Stores.exclusive_price', 'Stores.cover', 'Stores.created', 'Stores.lease_path', 'Stores.premium_path', 'Stores.exclusive_path', 'Stores.lease_name', 'Stores.lease_type', 'Stores.premium_name', 'Stores.exclusive_name', 'Genres.genre']);
        $query->where(['Stores.id < ' => $id]);
        $query->order(['Stores.created' => 'DESC'])->limit(10);

        $stores = $query;
        echo json_encode($stores);
    }

    /**
     * User Store method
     *
     * @return \Cake\Http\Response|void
     */
    public function userstore() {

        $this->loadModel('Carts');
        $cart = $this->Carts->getCount();

        $g = $this->Stores->find('all')->select(['Users.email', 'Users.aka','Stores.play_count' ,'Stores.id', 'Stores.name', 'Stores.length', 'Stores.bpm', 'Stores.lease_price', 'Stores.premium_price', 'Stores.exclusive_price', 'Stores.cover', 'Stores.created', 'Stores.lease_path', 'Stores.premium_path', 'Stores.exclusive_path', 'Stores.lease_name', 'Stores.premium_name', 'Stores.exclusive_name', 'Genres.genre'])->contain(['Genres', 'Users'])->where(['Stores.user_id' => $this->Auth->user('id')]);
        $stores = $this->paginate($g);
        $role = $this->Auth->user('role');
        $this->set(compact('stores', 'role', 'cart'));

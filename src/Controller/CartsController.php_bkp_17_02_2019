  public function sendFile($beattype,$beat)
  {
    $filePath = WWW_ROOT .'files'. DS .'Stores'. DS .$beattype. DS . $beat;
   $this->response->file(
    $filePath,['download' => true, 'name' => $beat]
  );
  if(!file_exists($filePath)){
    $this->Flash->error(__('Beat File not available. Contact admin'));
    return $this->redirect(['action'=>'paymentconfirm']);;
  }
  // Return the response to prevent controller from trying to render
  // a view.
  return $this->response;
  }
  
  

  
